<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.climateengine.additional-sensor-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/aloiscarnier/Developer/ClimateEngine/Scripts/run-sensor-connector.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CLIMATEENGINE_SHORTCUT_NAME</key>
        <string>ClimateEngine Additional Sensor Connector</string>
        <key>CLIMATEENGINE_RETRY_LOG</key>
        <string>/tmp/climateengine-additional-sensor-retry.log</string>
        <key>CLIMATEENGINE_RETRY_LOCK</key>
        <string>/tmp/climateengine-sensor-retry.lock</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>2</integer></dict>
        <dict><key>Minute</key><integer>7</integer></dict>
        <dict><key>Minute</key><integer>12</integer></dict>
        <dict><key>Minute</key><integer>17</integer></dict>
        <dict><key>Minute</key><integer>22</integer></dict>
        <dict><key>Minute</key><integer>27</integer></dict>
        <dict><key>Minute</key><integer>32</integer></dict>
        <dict><key>Minute</key><integer>37</integer></dict>
        <dict><key>Minute</key><integer>42</integer></dict>
        <dict><key>Minute</key><integer>47</integer></dict>
        <dict><key>Minute</key><integer>52</integer></dict>
        <dict><key>Minute</key><integer>57</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/tmp/climateengine-additional-sensor-poller.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/climateengine-additional-sensor-poller-error.log</string>
</dict>
</plist>
